<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.WorldScreen</RootNamespace>
    <AssemblyName>Stellar.WorldScreen</AssemblyName>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinned to 2.7.0 to match the framework DEPLOYED in the test prefix
         (release_3.7/.../Stellar.Framework/.stellar-version = 2.7.0). Referencing a higher
         Abstractions than the deployed framework ships risks an assembly-bind failure at load;
         WorldScreen uses only long-stable interfaces present in 2.7.0. -->
    <PackageReference Include="Stellar.Abstractions" Version="2.7.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.0.0" />
    <!-- UnityEngine.AudioModule (AudioSource/AudioClip for 3D positional audio) is NOT in the
         InteropRefs package; deploy.sh vendors the game's own interop stub into plugin/refs/.
         Private=false: the framework/game provides it at runtime — never ship it in the bundle. -->
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>refs/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="Stellar.WorldScreen.Tests" />
  </ItemGroup>
</Project>

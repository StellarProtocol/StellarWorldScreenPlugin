<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles production sources directly (below) rather than via ProjectReference to
       Stellar.WorldScreen.csproj, so most of the plugin stays unit-testable off-game with plain
       `dotnet test` without pulling in Stellar.Plugin.InteropRefs / AVProVideo / UnityEngine.
       Stellar.Abstractions IS referenced (Task 5, InstanceProbe) — it is a BCL-only contracts
       assembly (no BepInEx/Unity/Harmony per CLAUDE.md's dependency rule), so it carries no Unity
       dependency into this test project; only IClientState/IPlayerState/IEntityDetail/
       IGameEnvironment/IGameData/EntityId/Position3D types are used, faked in InstanceProbeTests. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <NoWarn>CS8632;CS8765</NoWarn>
    <!-- No net6.0 shared runtime is installed here (only 8.0.x/10.0.x) — roll the test host forward to
         whatever major is present so `dotnet test` actually executes instead of failing to launch. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- InstallKey/Es256 (plugin/Identity) are pure managed BouncyCastle — same version pin as the
         main plugin csproj — so the identity crypto is unit-testable off-game with plain `dotnet test`
         and the test itself can verify signatures via BouncyCastle (see InstallKeyTests.cs header). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.0" />
    <!-- Task 5 (InstanceProbe.Gather): BCL-only contracts assembly, matches the main plugin's pin.
         2.9.0 is not yet published to NuGet — see Stellar.WorldScreen.csproj's comment for the local
         pack/restore workaround; already seeded in the global package cache on this machine. -->
    <PackageReference Include="Stellar.Abstractions" Version="2.9.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The production files under test — compiled directly into this test assembly (not via
         ProjectReference to Stellar.WorldScreen.csproj, which pulls in InteropRefs/AVPro/Unity). -->
    <Compile Include="../Net/WireCodec.cs" />
    <Compile Include="../Net/PortalCanonical.cs" />
    <Compile Include="../Net/PortalDtos.cs" />
    <Compile Include="../Net/PortalClient.cs" />
    <Compile Include="../Net/PortalClient.Transport.cs" />
    <Compile Include="../Net/PortalClientDtos.cs" />
    <Compile Include="../Screen/FrameSink.cs" />
    <Compile Include="../Identity/InstallKey.cs" />
    <Compile Include="../Identity/Es256.cs" />
    <Compile Include="../World/InstanceProbe.cs" />
    <Compile Include="../World/PortalPlaylist.cs" />
    <!-- YtDlpResolver: BCL-only (Process/IO/Threading, no Unity) — MergeSelectorForHeight is pinned by
         YtDlpSelectorTests so the >360p stream-and-mux selector shape can't silently regress. -->
    <Compile Include="../Net/YtDlpResolver.cs" />
    <!-- ProgressiveServer: BCL-only loopback HTTP server for the single-file MP4 mux — pinned by
         ProgressiveServerTests (the part of the >360p path we CAN verify off-game; the AVPro/MediaFoundation
         side needs the game). -->
    <Compile Include="../Net/ProgressiveServer.cs" />
  </ItemGroup>
</Project>
